{
  "name": "@sparkkeeper/admin-web",
  "version": "0.0.0",
  "private": true,
  "description": "SparkKeeper admin web foundation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sparkkeeper/shared": "workspace:*",
    "vue": "^3.5.20",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  }
}
