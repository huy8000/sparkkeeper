{
  "name": "@sparkkeeper/server",
  "version": "0.0.0",
  "private": true,
  "description": "SparkKeeper server foundation",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @sparkkeeper/shared build && pnpm --filter @sparkkeeper/message-engine build && pnpm --filter @sparkkeeper/database build && pnpm --filter @sparkkeeper/automation build",
    "test": "tsx --test test/*.test.ts",
    "scheduler:smoke": "pnpm pretest && tsx scripts/scheduler-smoke.ts",
    "retry:smoke": "pnpm pretest && tsx scripts/retry-smoke.ts",
    "observability:smoke": "pnpm pretest && tsx scripts/observability-smoke.ts"
  },
  "dependencies": {
    "@sparkkeeper/automation": "workspace:*",
    "@sparkkeeper/database": "workspace:*",
    "@sparkkeeper/message-engine": "workspace:*",
    "@sparkkeeper/shared": "workspace:*",
    "pino": "^10.3.1"
  }
}
