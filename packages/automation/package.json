{
  "name": "@sparkkeeper/automation",
  "version": "0.0.0",
  "private": true,
  "description": "SparkKeeper browser automation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "auth:smoke": "tsx scripts/auth-smoke.ts",
    "browser:smoke": "tsx scripts/browser-smoke.ts",
    "chat:smoke": "tsx scripts/chat-smoke.ts",
    "contact:smoke": "tsx scripts/contact-smoke.ts",
    "send:smoke": "tsx scripts/send-smoke.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sparkkeeper/shared": "workspace:*",
    "playwright": "^1.62.1"
  }
}
