NODE_ENV=development
HOST=127.0.0.1
PORT=8080
APP_VERSION=development

DATA_DIR=./data
BROWSER_PROFILE_DIR=./data/browser-profile
BROWSER_HEADLESS=true

APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=14
SCREENSHOT_RETENTION_DAYS=14
TRACE_MODE=off
TRACE_RETENTION_DAYS=7

MVP_TARGET_DISPLAY_NAME=Test User
MVP_TEST_MESSAGE=Hello from SparkKeeper
MVP_ALLOW_REAL_SEND=false

SCHEDULER_ENABLED=false
SCHEDULER_ALLOW_REAL_SEND=false
SCHEDULER_ACCOUNT_ID=
SCHEDULER_MESSAGE_TEMPLATE_ID=

# Manual Run remains disabled unless the server operator explicitly enables it.
MANUAL_RUN_ENABLED=false

# Docker deployment stores all persistent state under this host directory.
SPARKKEEPER_DATA_DIR=./data

# Maintenance is opt-in. Point this at an ignored, non-empty local password file.
NOVNC_PASSWORD_FILE=./.secrets/novnc-password
NOVNC_SCREEN=1440x900x24
