{
  admin off
  log default {
    format filter {
      wrap json
      fields {
        request delete
        resp_headers delete
      }
    }
  }
  servers {
    protocols h1 h2
  }
}
import /etc/caddy/security.caddy
sparkkeeper.test {
  tls internal {
    protocols tls1.2 tls1.3
  }
  import sparkkeeper-security
}
